# Copy this file to .env.local and replace the placeholder locally.
# Never commit a real API key.
DEEPSEEK_API_KEY=replace_with_a_rotated_key
# Optional DeepSeek schedule/chat model. The schedule endpoint defaults to deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Optional OpenAI-compatible vision provider (supports image_url + JSON output).
# BASE_URL must include the provider API prefix, e.g. https://your-provider.example/v1
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
