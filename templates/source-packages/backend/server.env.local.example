# 复制为 server/.env.local 后填写。不要提交真实密钥。
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_MODEL=deepseek-flash

# 可选：OpenAI 兼容视觉服务
VISION_BASE_URL=
VISION_MODEL=qwen3-vl-plus
VISION_API_KEY=

# 可选：火山方舟图片代理
ARK_API_KEY=
ARK_IMAGE_MODEL=
ARK_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
