{
  "name": "zhiya-app-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-frontends.mjs",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:games",
    "build:web": "tsc -b && vite build",
    "build:games": "node scripts/build-embedded-games.mjs",
    "preview": "vite preview",
    "test": "vitest --run"
  },
  "dependencies": {
    "@zxing/library": "0.23.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.33.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
