{
  "name": "student-app-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:lan": "node scripts/start-lan-backend.mjs",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "build:games": "node scripts/build-embedded-games.mjs",
    "build": "npm run build:web && npm run build:games",
    "preview": "vite preview",
    "ai:server": "node server/ai-proxy.mjs",
    "cloud:gateway": "node server/cloudGateway.mjs",
    "test:cloud-runtime": "node --test deploy/aliyun/runtime.test.mjs",
    "test": "vitest",
    "test:server": "vitest run --config vitest.server.config.ts && node --test server/devProcesses.test.mjs server/devSupervisor.test.mjs server/recognition.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:repository-policy": "node --test scripts/repository-policy.test.mjs",
    "cleanup:check": "node scripts/cleanup-project.mjs --dry-run",
    "cleanup:apply": "node scripts/cleanup-project.mjs --apply",
    "import:brain-film": "node scripts/import-brain-film-work.mjs",
    "test:games": "npm test --workspace @zhiya/brain-film && npm run test:py --workspace @zhiya/brain-film && npm test --workspace @zhiya/creative-module",
    "test:all": "npm test -- --run && npm run test:server && npm run test:scripts && npm run test:games",
    "package:source": "node scripts/package-source-app.mjs",
    "package:complete": "node scripts/package-complete-app.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:release": "node scripts/build-android.mjs release"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@zhiya/task-client": "*",
    "@zxing/library": "^0.23.0",
    "jsqr": "^1.4.0",
    "lucide-react": "latest",
    "msedge-tts": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "latest",
    "sucrase": "^3.35.1",
    "typescript": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
